# Shared configuration for the three OSSF virtual machines (VMs).
# VM 1: GitLab CE, GitLab Runner, Docker and DefectDojo.
# VM 2: native SonarQube, JDK and local PostgreSQL.
# VM 3: native Nexus with the Java runtime bundled in its archive.
# Each installer uses only its own service settings and WAIT_TIMEOUT.
#
# Create config/ossf.env ONCE: bash scripts/init-config.sh
# Then copy the same private file to all three VMs, with permissions set to 600.
# Secrets stay empty in ossf.env.example; the initializer generates them in the copy.
# Do not commit the private copy or pass it to GitLab CI jobs.
#
# Format: KEY=literal value, one value per line; do not source this file.
# Do not add export, enclosing quotes or inline comments.
# The characters $, #, spaces and quotes WITHIN a value are preserved literally.
# Place comments on a separate line starting with #.
#
# Customize the domain, email addresses and settings before the first installation.
# Reruns must preserve the existing usernames, passwords and keys.
# Changing a version here does not replace the vendor's migration procedure.
# Passwords require at least 16 printable ASCII characters; keep the generated
# randomness to satisfy the applications' password-strength rules as well.

# SHARED — VM 1, VM 2 and VM 3.
# Readiness timeout in seconds; not an overall timeout for APT operations.
WAIT_TIMEOUT=900

# VM 1 — GitLab CE and Runner (install-gitlab-ce/gitlab-ubuntu-server.sh).
# VM 1 DNS name, without http://, a path or a port; the -d option takes precedence.
# DNS must point to VM 1. The script configures GitLab over HTTP on port 80.
GITLAB_DOMAIN=gitlab.example.com
# Exact GitLab CE APT package version, including the Debian suffix.
GITLAB_VERSION=19.4.1-ce.0
# Exact Runner APT package version installed on VM 1.
# Runner registration and its token are managed separately in GitLab.
RUNNER_VERSION=19.4.1-1
# Initial WEB administrator account; must be root. This is not the Unix account.
GITLAB_ADMIN_USER=root
# GitLab administrator email address; customize before installation.
GITLAB_ROOT_EMAIL=admin@example.com
# GitLab WEB password, used at account creation and verified on subsequent runs.
GITLAB_ROOT_PASSWORD=

# VM 2 — Native SonarQube (install-sonarqube/sonarqube-ubuntu-server.sh).
# ZIP path on VM 2; empty = official download. --archive takes precedence.
# The archive must match the version pinned in the SonarQube installer.
SONARQUBE_ARCHIVE=
# Expected SHA-256 checksum of the local or downloaded ZIP; this is not a secret.
# When changing versions, check the version, checksum, JDK and tests together.
SONARQUBE_SHA256=b7306f5ecfa6806753bc0eb0dc4ea11fe0ddd2c5a346592718814d6ec35b88cb
# SonarQube WEB administrator account on port 9000; must be admin.
SONARQUBE_ADMIN_USER=admin
# Replaces the initial admin password; separate from the PostgreSQL password.
SONARQUBE_ADMIN_PASSWORD=
# PostgreSQL role reserved for SonarQube on VM 2; not the sonar Unix account.
# Role and database: lowercase letters, digits, _; start with a letter or _, max 63 characters.
SONARQUBE_DB_USER=sonar
# SonarQube database on local PostgreSQL (localhost:5432 on VM 2).
SONARQUBE_DB_NAME=sonarqube
# Password for this PostgreSQL role; unrelated to the DefectDojo database on VM 1.
SONARQUBE_DB_PASSWORD=

# VM 3 — Native Nexus (install-nexus/nexus-ubuntu-server.sh).
# Sonatype archive version; uses its bundled Java runtime, not the one on VM 2.
NEXUS_VERSION=3.96.3-01
# Nexus WEB administrator account on port 8081; must be admin.
NEXUS_ADMIN_USER=admin
# Replaces the initial password generated by Nexus; not the nexus Unix account.
NEXUS_ADMIN_PASSWORD=

# VM 1 — DefectDojo in Docker (install-defectdojo/defectdojo-ubuntu-server.sh).
# If DefectDojo moves to a dedicated VM, this block and the Docker block apply to that VM.
# Git tag and application image version; PostgreSQL/Valkey follow upstream Compose.
DEFECTDOJO_VERSION=3.3.200
# Absolute directory ON VM 1, without spaces; not the local OSSF repository path.
# Also used by scripts/defectdojo-compose.sh to locate the installed stack.
INSTALL_DIR=/opt/defectdojo
# HTTP port published on VM 1; 8088 avoids GitLab's internal port 8080.
DD_PORT=8088
# TLS port published by Compose; distinct from DD_PORT. Certificates still need configuring.
DD_TLS_PORT=8443
# Customizable DefectDojo WEB administrator account; not the PostgreSQL role.
DD_ADMIN_USER=admin
# DefectDojo administrator email address; customize before installation.
DD_ADMIN_MAIL=admin@example.com
# DefectDojo WEB password passed to the initialization container.
DD_ADMIN_PASSWORD=
# PostgreSQL role inside the Docker stack on VM 1; upstream requires defectdojo.
DD_DATABASE_USER=defectdojo
# Internal database must be defectdojo; Compose host postgres:5432, not VM 2.
DD_DATABASE_NAME=defectdojo
# DefectDojo PostgreSQL password; preserve alongside the volumes in backups.
DD_DATABASE_PASSWORD=
# Django secret key (application signing), generated once; not a WEB password.
DD_SECRET_KEY=
# DefectDojo credential encryption key: exactly 32 hexadecimal characters.
# Do not regenerate for an existing database: encrypted data depends on this key.
DD_CREDENTIAL_AES_256_KEY=

# VM 1 — Docker Engine and Compose plugin (install-docker/docker-ubuntu-server.sh).
# Required for DefectDojo and a Docker executor Runner; not needed on VMs 2 and 3.
# Docker Engine AND client version, resolved to an exact APT package version by the script.
DOCKER_VERSION=29.8.1
# Version of the docker compose plugin; independent of the DefectDojo version.
COMPOSE_VERSION=5.5.1
